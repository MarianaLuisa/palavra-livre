# Palavra Livre - variaveis de ambiente
#
# O Jogo Livre funciona sem nenhuma destas variaveis.
# Elas so sao necessarias para habilitar o Campeonato Diario.
#
# Copie este arquivo para .env.local e preencha com os dados do seu projeto:
#   Supabase > Project Settings > API

# URL do projeto Supabase (sem barra no final).
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave publica (anon / publishable). Nunca use a service_role aqui:
# ela ignora RLS e daria acesso as respostas do campeonato.
VITE_SUPABASE_ANON_KEY=sua-chave-anon
